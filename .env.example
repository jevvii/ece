# Local development uses a project-owned Postgres cluster on 55432.
# Staging and production use the Supabase session-pooler connection string
# (port 5432, not the transaction pooler on 6543 — DDL and migrations need it).
DATABASE_URL=postgresql://ece@127.0.0.1:55432/ece_dev

# Uploaded time-report files. Omit these locally to use .data/uploads
# ("local"). Staging and production set all four to "supabase".
# STORAGE_BACKEND=supabase
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# SUPABASE_STORAGE_BUCKET=ece-uploads
