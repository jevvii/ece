# Local development uses a project-owned Postgres cluster on 55432.
# Staging and production use the Supabase session-pooler connection string:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?uselibpqcompat=true&sslmode=require
# Port 5432 (session pooler) — migrations run DDL. The uselibpqcompat flag is
# required: postgres.js and drizzle-kit's pg driver disagree about bare
# sslmode=require, and only this form connects in both.
DATABASE_URL=postgresql://ece@127.0.0.1:55432/ece_dev

# Uploaded time-report files. Omit these locally to use .data/uploads
# ("local"). Staging and production set all four to "supabase".
# STORAGE_BACKEND=supabase
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# SUPABASE_STORAGE_BUCKET=ece-uploads
